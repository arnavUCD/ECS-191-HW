# Copy to deploy.env (gitignored) for `scripts/deploy.sh`, or to .env (gitignored) for local runs,
# or export the values in your shell. Never commit real values.

# --- Required for deployment ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Private bucket for receipt images (uniform bucket-level access, no public principals).
SQUAREUP_ASSET_BUCKET=your-private-receipt-bucket

# --- Optional (defaults shown) ---
# Firebase project that issues ID tokens; defaults to GOOGLE_CLOUD_PROJECT.
# SQUAREUP_FIREBASE_PROJECT_ID=
# Origin used in invitation links; defaults to https://<project>.appspot.com on App Engine.
# SQUAREUP_PUBLIC_BASE_URL=
# Datastore namespace (e.g. to separate staging from production in one project).
# SQUAREUP_DATASTORE_NAMESPACE=
# SQUAREUP_INVITATION_TTL_HOURS=48
# SQUAREUP_GUEST_TTL_HOURS=72
# Shared-group invitation lifetime (milestone 7).
# SQUAREUP_GROUP_INVITATION_TTL_HOURS=168
# SQUAREUP_ASSET_RETENTION_DAYS=30
# Temporary rooms ("Split with people now"): open for claiming, then paying, then kept read-only.
# SQUAREUP_TEMPORARY_ROOM_TTL_HOURS=72
# SQUAREUP_TEMPORARY_ROOM_PAYMENT_DAYS=30
# SQUAREUP_TEMPORARY_ROOM_RETENTION_DAYS=30

# --- Apple (only with a paid Apple Developer Program team; enables AASA + App Clip banner) ---
# SQUAREUP_APPLE_TEAM_ID=
# SQUAREUP_APP_BUNDLE_ID=
# SQUAREUP_CLIP_BUNDLE_ID=
# The App Store ID of the full app (App Store Connect → App Information → Apple ID).
# SQUAREUP_APP_STORE_ID=
# 1 only once Apple has approved and released the App Clip experience: then (with the four values
# above) /r/ pages show the App Clip banner and card. The AASA file doesn't depend on it.
# SQUAREUP_APP_CLIP_LIVE=1

# --- Local development only (refused in production and on App Engine) ---
# SQUAREUP_ALLOW_DEV_AUTH=1
# SQUAREUP_BIND_HOST=0.0.0.0
# Don't load server/.env at startup (keeps a local test server from reading the Claude key).
# SQUAREUP_SKIP_LOCAL_ENV=1

# --- Receipt intelligence (milestone 5) ---
# off (default) | anthropic | recorded (development/evaluation only; refused in production)
# SQUAREUP_AI_PROVIDER=off
# Production (deploy.env): the Secret Manager resource NAME of the Claude key (not the key itself).
# SQUAREUP_ANTHROPIC_SECRET=projects/your-gcp-project-id/secrets/anthropic-api-key/versions/latest
# Local development only: the Claude API key. SECRET: set it only in your shell or the gitignored
# server/.env, never in a tracked file, never in deploy.env (deploy.sh refuses it), and never in the
# iOS app. Production ignores it and reads Secret Manager instead.
# ANTHROPIC_API_KEY=
# SQUAREUP_AI_MODEL=claude-opus-5-5
# SQUAREUP_AI_EFFORT=medium
# SQUAREUP_AI_REFUSAL_FALLBACK=default
# SQUAREUP_AI_TIMEOUT_SECONDS=50
# SQUAREUP_AI_MAX_OUTPUT_TOKENS=16000
# SQUAREUP_AI_CACHE_HOURS=24
# SQUAREUP_AI_RECORDED_DIR=
# Provider calls per verified account per day, per day across the project, and parses per minute.
# SQUAREUP_AI_DAILY_LIMIT_PER_ACCOUNT=10
# SQUAREUP_AI_DAILY_LIMIT_PROJECT=50
# SQUAREUP_AI_MINUTE_LIMIT=6
# Demo Mode's own daily budget (never counts toward the limits above): per demo workspace, and all demos together.
# SQUAREUP_AI_DEMO_DAILY_LIMIT_PER_WORKSPACE=50
# SQUAREUP_AI_DEMO_DAILY_LIMIT_PROJECT=50

# --- Demo Mode ---
# Starting a demo workspace creates sample records, so it's limited: per network per hour (generous,
# since a class on one Wi-Fi shares an address) and per day across everyone (the cost ceiling).
# SQUAREUP_DEMO_STARTS_PER_NETWORK_PER_HOUR=30
# SQUAREUP_DEMO_STARTS_PER_DAY=300
# 0 turns Enter Demo off entirely.
# SQUAREUP_DEMO_ENABLED=1
