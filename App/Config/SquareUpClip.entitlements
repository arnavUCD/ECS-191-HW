<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The one parent app this App Clip belongs to (exactly one entry). -->
	<key>com.apple.developer.parent-application-identifiers</key>
	<array>
		<string>$(AppIdentifierPrefix)$(SQUAREUP_APP_BUNDLE_ID)</string>
	</array>
	<!--
	The invitation domain (Config/Remote.xcconfig): App Clip invocations from https://<domain>/r/<token>
	(QR code, Messages, the /r/ page's Smart App Banner). The server's apple-app-site-association file
	lists this App Clip under "appclips". No path, slash, or wildcard here.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>appclips:$(SQUAREUP_INVOCATION_DOMAIN)</string>
	</array>
</dict>
</plist>
