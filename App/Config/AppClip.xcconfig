// App Clip identifiers. Both are registered under the paid Apple Developer Program team
// (9L56L8Y5R3, set as DEVELOPMENT_TEAM on both targets) by Xcode's automatic signing — see
// HW/App/APP_CLIP_ACTIVATION.md.
//
// The App Clip's bundle ID must start with the full app's bundle ID. Firebase phone sign-in and the
// server's apple-app-site-association file both depend on these values: change them only together.

// The full app's bundle ID (the SquareUp target's PRODUCT_BUNDLE_IDENTIFIER).
SQUAREUP_APP_BUNDLE_ID = edu.ucdavis.ecs191.SquareUp
// Apple's naming rule: the parent's ID plus a suffix.
SQUAREUP_CLIP_BUNDLE_ID = $(SQUAREUP_APP_BUNDLE_ID).Clip

// The invocation domain (SQUAREUP_INVOCATION_DOMAIN) and server host come from Remote.xcconfig.
#include "Remote.xcconfig"
