# Square Up SwiftFormat configuration. Run `swiftformat --lint .` in CI; `swiftformat .` locally.
--swiftversion 6.0
--exclude SquareUpTests/Snapshots/__Snapshots__
--indent 4
--maxwidth 180
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--commas always
--self remove
--stripunusedargs closure-only
--header ignore
--importgrouping alpha
# Rules disabled to avoid churn against Xcode's default style.
--disable redundantReturn,wrapMultilineStatementBraces,blankLinesAtStartOfScope,andOperator,preferKeyPath,redundantType,docComments,wrapIfStatementBodies,wrapPropertyBodies,wrapFunctionBodies,wrapIfExpressionBodies,wrapLoopBodies,noForceUnwrapInTests,hoistPatternLet,hoistTry,conditionalAssignment,opaqueGenericParameters,redundantViewBuilder,wrap,wrapArguments,numberFormatting,swiftTestingTestCaseNames
--ifdef no-indent
--ranges no-space
